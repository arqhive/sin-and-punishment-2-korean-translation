 "subtitles": [
  {
   "id": "TX0_0#0",
   "ko": "시스템 올 그린. 대기권 돌파까지 앞으로 30초."
  },
  {
   "id": "TX0_0#1",
   "ko": "이대로 이 지구를 빠져나갈 수 있으면 좋겠는데..."
  },
  {
   "id": "TX0_0#2",
   "ko": "여자를 넘겨라...   여자를 넘겨라..."
  },
  {
   "id": "TX0_0#3",
   "ko": "그리 쉽게 보내 주진 않겠군..."
  },
  {
   "id": "TX0_0#4",
   "ko": "안 돼!   떨어진다!"
  },
  {
   "id": "TX0_0#5",
   "ko": "이사...   이사..."
  },
  {
   "id": "TX0_0#6",
   "ko": "아, 카치. 괜찮아?"
  },
  {
   "id": "TX0_0#7",
   "ko": "맞다! 상황은?"
  },
  {
   "id": "TX0_0#8",
   "ko": "심하게 당했군. 이대로라면 오래 못 버티겠어."
  },
  {
   "id": "TX0_0#9",
   "ko": "게다가 보안 잠금까지 걸려 있잖아.\n침입자가 있는 건가!"
  },
  {
   "id": "TX0_0#10",
   "ko": "아무튼 여긴 이제 위험해.\n빨리 이 배에서 탈출하자."
  },
  {
   "id": "TX0_0#11",
   "ko": "방에 있는 적을 처치해 나가면\n잠금이 풀릴 거야."
  },
  {
   "id": "TX0_0#12",
   "ko": "여기 잠금을 풀면 밖으로 나갈 수 있을 거야."
  },
  {
   "id": "TX0_0#13",
   "ko": "왜 이 녀석이 움직이는 거야!?"
  },
  {
   "id": "TX0_0#14",
   "ko": "성가신 기계네!"
  },
  {
   "id": "TX0_0#15",
   "ko": "더는 못 버텨."
  },
  {
   "id": "TX0_0#16",
   "ko": "어서 여기서 벗어나!"
  },
  {
   "id": "TX1_1#0",
   "ko": "...읏!   간신히 무사한 것 같군."
  },
  {
   "id": "TX1_1#1",
   "ko": "맞다, 카치는...?   카치...! 카치!"
  },
  {
   "id": "TX1_1#2",
   "ko": "너...   괜찮은 거야...?"
  },
  {
   "id": "TX1_1#3",
   "ko": "뭐야..."
  },
  {
   "id": "TX1_1#4",
   "ko": "여긴...?"
  },
  {
   "id": "TX1_1#5",
   "ko": "아무래도 지하 도시인 것 같군.\n여기까지 날려 온 모양이야."
  },
  {
   "id": "TX1_1#6",
   "ko": "호오...   살아 있었나."
  },
  {
   "id": "TX1_1#7",
   "ko": "그 여자를 넘겨라.\n지금이라면 네놈의 명령 위반도 눈감아 주지."
  },
  {
   "id": "TX1_1#8",
   "ko": "크크크...   도망칠 수는 없다. ...절대로."
  },
  {
   "id": "TX1_1#9",
   "ko": "자!   여자를 넘겨라!"
  },
  {
   "id": "TX1_1#10",
   "ko": "알았다."
  },
  {
   "id": "TX1_1#11",
   "ko": "그래야지. 현명한 선택이다."
  },
  {
   "id": "TX1_1#12",
   "ko": "사람 가죽을 뒤집어쓴 괴물 같으니..."
  },
  {
   "id": "TX1_1#13",
   "ko": "칫...   놓쳤나. 뭐, 좋다. 어차피 독 안에 든 쥐다."
  },
  {
   "id": "TX1_1#14",
   "ko": "저 녀석은 누구야?"
  },
  {
   "id": "TX1_1#15",
   "ko": "추격자야. 카치, 널 노리고 있어."
  },
  {
   "id": "TX1_1#16",
   "ko": "이제 어떻게 할 거야?"
  },
  {
   "id": "TX1_1#17",
   "ko": "우선 여기서 탈출이다. 곧 놈들이 쫓아올 거야!"
  },
  {
   "id": "TX1_1#18",
   "ko": "!!...   키퍼즈까지!?"
  },
  {
   "id": "TX1_1#19",
   "ko": "안으로 들어가자. 조금은 시간을 벌 수 있을 거야."
  },
  {
   "id": "TX1_1#20",
   "ko": "도망칠 수 없다고 했을 텐데."
  },
  {
   "id": "TX1_1#21",
   "ko": "...읏!"
  },
  {
   "id": "TX1_1#22",
   "ko": "카치!"
  },
  {
   "id": "TX1_1#23",
   "ko": "이사!"
  },
  {
   "id": "TX1_1#24",
   "ko": "크윽...   역시 꼭두각시로는 막을 수 없나...\n육체 복원을 서둘러야겠군."
  },
  {
   "id": "TX1_1#25",
   "ko": "놈들, 연구소로 도망칠 셈인가.\n분명 거기엔 초대형 키퍼가 있었을 텐데."
  },
  {
   "id": "TX1_1#26",
   "ko": "살아서 나올 수 있으려나?...   크크..."
  },
  {
   "id": "TX1_1#27",
   "ko": "받아라!"
  },
  {
   "id": "TX1_2#0",
   "ko": "시스템이 살아 있군...   놈들이 재가동한 건가?"
  },
  {
   "id": "TX1_2#1",
   "ko": "여기서 탈출할 방법이 있는지 좀 알아볼게."
  },
  {
   "id": "TX1_2#2",
   "ko": "있잖아, 아까 쓰러뜨린 괴물도 저 녀석들 한패야?"
  },
  {
   "id": "TX1_2#3",
   "ko": "괴물...?   아아, 아니야. 그건 키퍼즈야."
  },
  {
   "id": "TX1_2#4",
   "ko": "이 지구는 먼 옛날 문명이 너무 발달해서 버려진 별이야."
  },
  {
   "id": "TX1_2#5",
   "ko": "그리고 망가진 지구를 고치려고\n만들어진 인조 생명체가 키퍼즈야."
  },
  {
   "id": "TX1_2#6",
   "ko": "뭐, 이 지구 입장에서 우리는\n밖에서 온 이물질이니까."
  },
  {
   "id": "TX1_2#7",
   "ko": "키퍼즈는 우리를 외적으로 보고 공격해 오는 거겠지."
  },
  {
   "id": "TX1_2#8",
   "ko": "...좋아, 됐다!\n잘하면 이 지구에서 탈출할 수 있을지도 몰라."
  },
  {
   "id": "TX2_1#0",
   "ko": "해저 튜브?"
  },
  {
   "id": "TX2_1#1",
   "ko": "그래."
  },
  {
   "id": "TX2_1#2",
   "ko": "우리가 떨어진 곳은 규슈의 후쿠오카 근처야."
  },
  {
   "id": "TX2_1#3",
   "ko": "여기서 세토나이카이의 해저 튜브를 지나간다.\n바닷속이라면 적도 별로 없을 거야."
  },
  {
   "id": "TX2_1#4",
   "ko": "튜브를 빠져나가면 세토나이카이 상공에\n공중 스테이션이 있어."
  },
  {
   "id": "TX2_1#5",
   "ko": "공중 스테이션이라면\n우주선 한두 대는 있겠지."
  },
  {
   "id": "TX2_1#6",
   "ko": "그걸 슬쩍해서 이 지구를 탈출하자."
  },
  {
   "id": "TX2_1#7",
   "ko": "그렇게 잘될까?"
  },
  {
   "id": "TX2_1#8",
   "ko": "글쎄?   그래도 그런 건 해 봐야 아는 거잖아?"
  },
  {
   "id": "TX2_1#9",
   "ko": "오!   저게 입구인가?"
  },
  {
   "id": "TX2_1#10",
   "ko": "우왓!   빨려 들어간다!?"
  },
  {
   "id": "TX2_1#11",
   "ko": "뭐야!?   놈들의 모함인가?"
  },
  {
   "id": "TX2_1#12",
   "ko": "크다고 다 좋은 건 아니야."
  },
  {
   "id": "TX2_3#0",
   "ko": "난감하군. 바닷속도 적투성이잖아..."
  },
  {
   "id": "TX2_3#1",
   "ko": "게다가 이 기계...   최근에 만든 거군."
  },
  {
   "id": "TX2_3#2",
   "ko": "놈들, 이런 걸 두고 뭘 꾸미는 거지?"
  },
  {
   "id": "TX2_3#3",
   "ko": "있잖아, 저 녀석들은 왜 나를 노리는 걸까?"
  },
  {
   "id": "TX2_3#4",
   "ko": "내가 사람이 아니라서?"
  },
  {
   "id": "TX2_3#5",
   "ko": "...글쎄, 적어도 사람이 아닌 건 확실하지."
  },
  {
   "id": "TX2_3#6",
   "ko": "있잖아, 사람이 뭐야?"
  },
  {
   "id": "TX2_3#7",
   "ko": "그야, 너, 사람이란 건 말이지..."
  },
  {
   "id": "TX2_3#8",
   "ko": "이렇게, 머리가 있고, 눈이 두 개 있고 말이야..."
  },
  {
   "id": "TX2_3#9",
   "ko": "코랑 입이 있고?"
  },
  {
   "id": "TX2_3#10",
   "ko": "그렇지."
  },
  {
   "id": "TX2_3#11",
   "ko": "몸이 있고, 팔이 두 개 있고?"
  },
  {
   "id": "TX2_3#12",
   "ko": "그렇지."
  },
  {
   "id": "TX2_3#13",
   "ko": "다리가 두 개 있고?"
  },
  {
   "id": "TX2_3#14",
   "ko": "그렇지."
  },
  {
   "id": "TX2_3#15",
   "ko": "꼬리가 있고?"
  },
  {
   "id": "TX2_3#16",
   "ko": "그렇..."
  },
  {
   "id": "TX2_3#17",
   "ko": "...가 아니라, 꼬리는 없잖아!"
  },
  {
   "id": "TX2_3#18",
   "ko": "즐거워 보이는군."
  },
  {
   "id": "TX2_3#19",
   "ko": "동지 이사여. 너는 그 여자를 처치하려고\n이 지구에 온 것 아니냐?"
  },
  {
   "id": "TX2_3#20",
   "ko": "그런데 어째서 처치해야 할 상대와\n같이 다니는 거지?"
  },
  {
   "id": "TX2_3#21",
   "ko": "...마음이 바뀌었거든."
  },
  {
   "id": "TX2_3#22",
   "ko": "호오...   신의 뜻을 거스르겠다는 건가?"
  },
  {
   "id": "TX2_3#23",
   "ko": "미안하지만 난 신 따윈 안 믿거든!"
  },
  {
   "id": "TX2_3#24",
   "ko": "사람의 모습을 흉내 낸 그 여자는\n우리에게 위협이 되는 존재란 말이다."
  },
  {
   "id": "TX2_3#25",
   "ko": "동지 이사여, 너도 그건 알고 있겠지?"
  },
  {
   "id": "TX2_3#26",
   "ko": "후하하, 어딜 노리는 거냐?"
  },
  {
   "id": "TX2_4#0",
   "ko": "하하하...   방금 건 제법 재미있었다."
  },
  {
   "id": "TX2_4#1",
   "ko": "동지 이사여. 아니, 전 동지라고 해야 하나?"
  },
  {
   "id": "TX2_4#2",
   "ko": "네 결의는 잘 알았다. 하지만 말이다..."
  },
  {
   "id": "TX2_4#3",
   "ko": "나도 빈손으로 돌아갈 수는 없지."
  },
  {
   "id": "TX2_4#4",
   "ko": "어디, 잠깐 상대해 주마."
  },
  {
   "id": "TX2_4#5",
   "ko": "그렇군...   소문 그대로의 전투력이군..."
  },
  {
   "id": "TX2_4#6",
   "ko": "이사여...\n우리는 이 땅에서 지맥의 힘이 가장 모이는 곳에 있다."
  },
  {
   "id": "TX2_4#7",
   "ko": "불사의 산이라고 하면 알기 쉬울까?"
  },
  {
   "id": "TX2_4#8",
   "ko": "마음이 내키면 언제든 오너라. 환영하마."
  },
  {
   "id": "TX2_4#9",
   "ko": "불사의 산이라고...?   후지산 말인가..."
  },
  {
   "id": "TX2_4#10",
   "ko": "놈들의 도발에 넘어갈 필요 없어. 서두르자."
  },
  {
   "id": "TX2_4#11",
   "ko": "이사."
  },
  {
   "id": "TX3_1#0",
   "ko": "경계가 삼엄하군. 어쩔래? 정면 돌파할까?"
  },
  {
   "id": "TX3_1#1",
   "ko": "그나저나 좀 더 나은 곳으로 나올 순 없었어?\n더워 죽겠네."
  },
  {
   "id": "TX3_1#2",
   "ko": "어머, 이래 봬도 꽤 신경 쓴 거야."
  },
  {
   "id": "TX3_1#3",
   "ko": "뭐야 너, 혼자만..."
  },
  {
   "id": "TX3_1#4",
   "ko": "그럼 난..."
  },
  {
   "id": "TX3_1#5",
   "ko": "저걸 가져가 볼까."
  },
  {
   "id": "TX3_1#6",
   "ko": "애 하나 상대로 이런 병력이라니..."
  },
  {
   "id": "TX3_1#7",
   "ko": "저기 있다!!"
  },
  {
   "id": "TX3_6#0",
   "ko": "순조롭군. 이대로면 후지산까지 금방이겠어."
  },
  {
   "id": "TX3_6#1",
   "ko": "뭐야, 아직 할 거야?"
  },
  {
   "id": "TX3_6#2",
   "ko": "아니야, 이사.   후훗...\n이 아이, 이사가 마음에 든 모양이야."
  },
  {
   "id": "TX3_6#3",
   "ko": "『나보다 센 녀석은 처음이야』래."
  },
  {
   "id": "TX3_6#4",
   "ko": "헤, 그래!   네 펀치도 꽤 대단했어!"
  },
  {
   "id": "TX3_6#5",
   "ko": "이사, 이 아이가 후지산까지 데려다준대."
  },
  {
   "id": "TX4_1#0",
   "ko": "어떻게 된 거야?   우리는?"
  },
  {
   "id": "TX4_1#1",
   "ko": "뒤틀린 공간에 떨어졌어."
  },
  {
   "id": "TX4_1#2",
   "ko": "진짜냐..."
  },
  {
   "id": "TX4_1#3",
   "ko": "하지만 여긴 만들어진 곳이야. 누군가의 힘이 느껴져..."
  },
  {
   "id": "TX4_1#4",
   "ko": "어딘가에 우리를 가둬 놓은 녀석이\n있다는 거군."
  },
  {
   "id": "TX4_1#5",
   "ko": "그 녀석을 찾자."
  },
  {
   "id": "TX4_3#0",
   "ko": "달이 참 예쁘군..."
  },
  {
   "id": "TX4_3#1",
   "ko": "가만히 보고 있으면 어느 쪽이 진짜 달인지\n헷갈릴 것 같아..."
  },
  {
   "id": "TX4_3#2",
   "ko": "사키!   사키이이!"
  },
  {
   "id": "TX4_3#3",
   "ko": "엄마, 엄마!   저건 아빠야? 아빠야?"
  },
  {
   "id": "TX4_3#4",
   "ko": "있잖아, 엄마. 나도 언젠가 아빠처럼\n괴물이 되는 거야?"
  },
  {
   "id": "TX4_3#5",
   "ko": "글쎄...   그렇게 될지도 모르겠구나..."
  },
  {
   "id": "TX4_3#6",
   "ko": "잘 들으렴, 이사.   네 힘을 어디에 쓸지는\n너 스스로 정하렴."
  },
  {
   "id": "TX4_3#7",
   "ko": "신에게 기대선 안 돼. 성녀를 믿어서도 안 돼."
  },
  {
   "id": "TX4_3#8",
   "ko": "스스로 생각해서 그 힘을 쓰렴."
  },
  {
   "id": "TX4_3#9",
   "ko": "그리고 마음이 날뛰지 않도록 네 마음을\n붙잡아 줄 수 있는 파트너를 찾으렴."
  },
  {
   "id": "TX4_3#10",
   "ko": "파트너?"
  },
  {
   "id": "TX4_3#11",
   "ko": "그래, 이사. 그리고 말이야..."
  },
  {
   "id": "TX4_3#12",
   "ko": "아빠는 괴물이 아니잖니?"
  },
  {
   "id": "TX4_3#13",
   "ko": "아빠는 아빠잖니?"
  },
  {
   "id": "TX4_3#14",
   "ko": "물은 과거...   얘야, 무엇이 보였니?"
  },
  {
   "id": "TX4_3#15",
   "ko": "숲은 현재...   얘야, 무엇을 망설이고 있니?"
  },
  {
   "id": "TX4_3#16",
   "ko": "그리고 하늘은 미래... 검은색은 절망? 아니면 가능성?"
  },
  {
   "id": "TX4_3#17",
   "ko": "드디어 만났군. 여길 만든 게 너냐!"
  },
  {
   "id": "TX4_3#18",
   "ko": "그렇지 않아...   여긴 네 마음을 비춘 세계..."
  },
  {
   "id": "TX4_3#19",
   "ko": "여길 만들고 있는 건 너 자신."
  },
  {
   "id": "TX4_3#20",
   "ko": "잔말은 됐어. 간다!"
  },
  {
   "id": "TX4_3#21",
   "ko": "말 많은 새네."
  },
  {
   "id": "TX4_3#22",
   "ko": "아까 물에 비친 건 옛날의 이사야?"
  },
  {
   "id": "TX4_3#23",
   "ko": "아아...   사람은 잊고 싶은 것일수록\n잘 기억하는 법이지."
  },
  {
   "id": "TX4_3#24",
   "ko": "옛날 일을 기억하는 게 사람이야?"
  },
  {
   "id": "TX4_3#25",
   "ko": "정신을 차려 보니 난 이 지구에 혼자 있었어.\n옛날 일 같은 건 기억나지 않아..."
  },
  {
   "id": "TX4_3#26",
   "ko": "신경 쓸 것 없어. 지금을 쌓아 가면\n그게 언젠가 옛날이 되니까."
  },
  {
   "id": "TX4_3#27",
   "ko": "...그래도 옛날의 카치라. 조금 궁금하긴 하네."
  },
  {
   "id": "TX4_3#28",
   "ko": "뭔가 떠오르면 알려 줘."
  },
  {
   "id": "TX5_1#0",
   "ko": "보인다. 저거 아냐?"
  },
  {
   "id": "TX5_1#1",
   "ko": "단숨에 올라간다!"
  },
  {
   "id": "TX5_3#0",
   "ko": "늦어~!   기다리다 지쳤잖아!"
  },
  {
   "id": "TX5_3#1",
   "ko": "네가 이사?   난 히바루라고 해!"
  },
  {
   "id": "TX5_3#2",
   "ko": "너, 세다며?\n옛날엔 우리 대장이랑 막상막하였다면서?"
  },
  {
   "id": "TX5_3#3",
   "ko": "흐음, 얼굴은 그럭저럭. 옷도 나쁘지 않고. 근데..."
  },
  {
   "id": "TX5_3#4",
   "ko": "여자 보는 눈은 별로인가 봐."
  },
  {
   "id": "TX5_3#5",
   "ko": "있잖아, 그런 애 말고 나랑 사귀지 않을래?   물론..."
  },
  {
   "id": "TX5_3#6",
   "ko": "나한테 이긴다면 말이지만."
  },
  {
   "id": "TX5_3#7",
   "ko": "있잖아, 내가 그 애한테 이기면..."
  },
  {
   "id": "TX5_3#8",
   "ko": "나랑 사귀어 줄래?"
  },
  {
   "id": "TX5_3#9",
   "ko": "졌다, 졌어!"
  },
  {
   "id": "TX5_3#10",
   "ko": "헤에, 너 정말 세구나."
  },
  {
   "id": "TX5_3#11",
   "ko": "큰일이다!   우리가 좀 너무 소란을 피웠나 봐."
  },
  {
   "id": "TX5_3#12",
   "ko": "자고 있던 무서운 녀석이 깨어날 것 같으니까\n난 이만 갈게."
  },
  {
   "id": "TX5_3#13",
   "ko": "기다려!   아까 너희 보스가 옛날에 나랑\n막상막하였다고 했지."
  },
  {
   "id": "TX5_3#14",
   "ko": "그 녀석의 이름은 혹시..."
  },
  {
   "id": "TX5_3#15",
   "ko": "잠깐!   뭐야 이 녀석!   날뛰지 마!"
  },
  {
   "id": "TX5_3#16",
   "ko": "안 되겠어, 감당이 안 돼."
  },
  {
   "id": "TX5_3#17",
   "ko": "이사, 위험해!"
  },
  {
   "id": "TX5_3#18",
   "ko": "이거 참, 우주선을 찾을 상황이 아니었군."
  },
  {
   "id": "TX5_3#19",
   "ko": "거봐, 역시 잘 안 됐잖아."
  },
  {
   "id": "TX5_3#20",
   "ko": "하하...   가끔은 이런 일도 있지.\n해 보는 게 중요한 거야."
  },
  {
   "id": "TX5_3#21",
   "ko": "저기에도 놈들 한패가 있었지.\n게다가 놈들의 보스..."
  },
  {
   "id": "TX5_3#22",
   "ko": "그게 만약 그 녀석이라면 도망치기도 어렵겠는데..."
  },
  {
   "id": "TX5_3#23",
   "ko": "좋아!   도망치는 건 이제 그만이다."
  },
  {
   "id": "TX5_3#24",
   "ko": "놈들, 후지산에 있다고 했지.\n이쪽에서 쳐들어가서 결판을 낸다."
  },
  {
   "id": "TX5_3#25",
   "ko": "그건 그렇고, 텔레포트를 할 수 있으면\n처음부터 말해 주지 그랬어."
  },
  {
   "id": "TX5_3#26",
   "ko": "이왕이면 이대로 후지산까지 데려다줘."
  },
  {
   "id": "TX5_3#27",
   "ko": "가 본 적 없는 곳으로 정확히 날아가는 건 무리야."
  },
  {
   "id": "TX5_3#28",
   "ko": "게다가 텔레포트는 위험해."
  },
  {
   "id": "TX5_3#29",
   "ko": "시공의 뒤틀림에 빠지면 못 나올지도 몰라."
  },
  {
   "id": "TX6_1#0",
   "ko": "저게 이 지구의 후지산?   엄청나게 변했군."
  },
  {
   "id": "TX6_1#1",
   "ko": "꼭 요새 같네."
  },
  {
   "id": "TX6_1#2",
   "ko": "여기까지면 돼. 고마워!"
  },
  {
   "id": "TX6_3#0",
   "ko": "이 열차를 타면 내부로 침입할 수 있지 않을까?"
  },
  {
   "id": "TX6_3#1",
   "ko": "저 녀석은 뭐야...?"
  },
  {
   "id": "TX6_3#2",
   "ko": "단단하네."
  },
  {
   "id": "TX6_3#3",
   "ko": "전혀 안 먹히는 건가?"
  },
  {
   "id": "TX6_3#4",
   "ko": "그럼...   이건 어떠냐!"
  },
  {
   "id": "TX6_3#5",
   "ko": "이 열차...   폭주하고 있는 건가?\n꽉 붙잡지 않으면 위험하겠어."
  },
  {
   "id": "TX6_3#6",
   "ko": "빠르네. 섣불리 뛰었다간 날아가 버리겠어."
  },
  {
   "id": "TX6_3#7",
   "ko": "해치웠나?"
  },
  {
   "id": "TX6_3#8",
   "ko": "큰일 날 뻔했다!   방금 건 대체 뭐였지?"
  },
  {
   "id": "TX6_3#9",
   "ko": "아이가 있었구나."
  },
  {
   "id": "TX6_3#10",
   "ko": "그래, 좀 불쌍한 짓을 했는지도 모르겠군."
  },
  {
   "id": "TX6_3#11",
   "ko": "잠깐!   잠깐만!"
  },
  {
   "id": "TX6_3#12",
   "ko": "기다려, 카치. 지금 구해 줄게!"
  },
  {
   "id": "TX6_3#13",
   "ko": "정말 못 말리는 꼬마 녀석이군!"
  },
  {
   "id": "TX6_3#14",
   "ko": "으악, 뭐 하는 거야 이 녀석!"
  },
  {
   "id": "TX6_3#15",
   "ko": "이사!?"
  },
  {
   "id": "TX6_3#16",
   "ko": "괜찮아?"
  },
  {
   "id": "TX6_3#17",
   "ko": "그럭저럭 괜찮아. 정말 험한 꼴 당했네."
  },
  {
   "id": "TX6_3#18",
   "ko": "괜찮아?"
  },
  {
   "id": "TX6_3#19",
   "ko": "하하...   간신히. 고마워, 카치."
  },
  {
   "id": "TX6_3#20",
   "ko": "이사!"
  },
  {
   "id": "TX6_3#21",
   "ko": "카치!"
  },
  {
   "id": "TX6_4#0",
   "ko": "여긴...?"
  },
  {
   "id": "TX6_4#1",
   "ko": "오랜만이군, 이사."
  },
  {
   "id": "TX6_4#2",
   "ko": "훈련생 시절 이후인가?"
  },
  {
   "id": "TX6_4#3",
   "ko": "다시 만나길 기대했어."
  },
  {
   "id": "TX6_4#4",
   "ko": "데코...   역시 네놈이었나."
  },
  {
   "id": "TX6_4#5",
   "ko": "아직 시간이 좀 있군..."
  },
  {
   "id": "TX6_4#6",
   "ko": "옛날처럼 한판 붙어 보자고."
  },
  {
   "id": "TX6_4#7",
   "ko": "어디, 윗분들이 호들갑 떠는 그 힘 좀 구경해 볼까."
  },
  {
   "id": "TX6_4#8",
   "ko": "역시 대단하군. 또 강해진 것 같은데?"
  },
  {
   "id": "TX6_4#9",
   "ko": "헤에...   그렇군..."
  },
  {
   "id": "TX6_4#10",
   "ko": "칫...   벌써 시간이 다 됐나."
  },
  {
   "id": "TX6_4#11",
   "ko": "아아아아아악!"
  },
  {
   "id": "TX6_4#12",
   "ko": "데코!   네놈, 무슨 짓을 한 거냐!"
  },
  {
   "id": "TX6_4#13",
   "ko": "사람이 아닌 것에만 듣는 파동이다."
  },
  {
   "id": "TX6_4#14",
   "ko": "뭐라고?"
  },
  {
   "id": "TX6_4#15",
   "ko": "아직 승부는 안 끝났다고!?   한눈팔 때냐?"
  },
  {
   "id": "TX6_4#16",
   "ko": "카치!"
  },
  {
   "id": "TX6_4#17",
   "ko": "카치이...   카치..."
  },
  {
   "id": "TX6_4#18",
   "ko": "곧 그 여자는 사람의 모습을 유지하지 못하게 된다.\n어쩔 테냐, 이사?"
  },
  {
   "id": "TX6_4#19",
   "ko": "그래도 너는 그 여자...   아니,\n그 괴물을 지키려는 건가?"
  },
  {
   "id": "TX6_4#20",
   "ko": "답이 정해지면 꼭 알려 줘. 위에서 기다리지."
  },
  {
   "id": "TX6_5#0",
   "ko": "조금이라도 여기서 멀어져야..."
  },
  {
   "id": "TX6_5#1",
   "ko": "아차!"
  },
  {
   "id": "TX6_5#2",
   "ko": "카치!   네 마음은 내가 붙잡아 줄게. 그러니까...!"
  },
  {
   "id": "TX6_5#3",
   "ko": "내 마음을 붙잡아 줘!"
  },
  {
   "id": "TX6_5#4",
   "ko": "여긴...?   이사가 느껴져...   이사 안인가...?\n왠지 따뜻해..."
  },
  {
   "id": "TX6_5#5",
   "ko": "카치...   들려?"
  },
  {
   "id": "TX6_5#6",
   "ko": "이사?..."
  },
  {
   "id": "TX6_5#7",
   "ko": "고마워. 카치가 나를 느껴 주는 한\n나는 나로 남을 수 있을 것 같아."
  },
  {
   "id": "TX6_5#8",
   "ko": "그리고 나도 카치를 느껴..."
  },
  {
   "id": "TX6_5#9",
   "ko": "우리 G5는 지금 이 자리에서 제4 아지구의 폐기와,\n외우주 생명체를 품은 도망자 이사 조의 배제를 결정한다!"
  },
  {
   "id": "TX6_5#10",
   "ko": "이 결정은 우리의 권한으로 즉시 실행된다!"
  },
  {
   "id": "TX6_5#11",
   "ko": "가자, 결판을 내자."
  },
  {
   "id": "TX7_1#0",
   "ko": "저건가?   놈들의 배는."
  },
  {
   "id": "TX7_1#1",
   "ko": "놈들, 지구째로 지워 버릴 셈인가?"
  },
  {
   "id": "TX7_1#2",
   "ko": "키퍼즈!?"
  },
  {
   "id": "TX7_1#3",
   "ko": "우리도 간다!"
  },
  {
   "id": "TX7_6#0",
   "ko": "이사, 그게 네 진짜 모습인가.\n그 여자를 흡수하면서까지..."
  },
  {
   "id": "TX7_6#1",
   "ko": "뭐, 좋아. 한 번쯤 전력을 다한 너와 싸워 보고 싶다고\n줄곧 생각했어."
  },
  {
   "id": "TX7_6#2",
   "ko": "그런 의미에선 그 여자에게 감사해야겠군."
  },
  {
   "id": "TX7_6#3",
   "ko": "그럼 나도 전력으로 가겠다!"
  },
  {
   "id": "TX7_6#4",
   "ko": "몸은 역시 강하군. 하지만 마음은 어떠냐?"
  },
  {
   "id": "TX7_6#5",
   "ko": "너는 정말로 그 여자를 받아들일 수 있는 거냐?"
  },
  {
   "id": "TX7_6#6",
   "ko": "신에게 맞선다는 건 성녀 편에 선다는 건가?"
  },
  {
   "id": "TX7_6#7",
   "ko": "이 우주를 멸망시키게 된다고."
  },
  {
   "id": "TX7_6#8",
   "ko": "카치는 성녀 따위가 아니야."
  },
  {
   "id": "TX7_6#9",
   "ko": "카치는 카치다!"
  },
  {
   "id": "TX7_7#0",
   "ko": "끝난 거야...?"
  },
  {
   "id": "TX7_7#1",
   "ko": "그래."
  },
  {
   "id": "TX7_7#2",
   "ko": "어떻게 할 거야?   이제부터?"
  },
  {
   "id": "TX7_7#3",
   "ko": "어쩔까?   지구로 돌아갈까?"
  },
  {
   "id": "TX7_7#4",
   "ko": "지구로 돌아가면 키퍼즈가 있어."
  },
  {
   "id": "TX7_7#5",
   "ko": "뭐, 시간을 들이면 그 녀석들과도 서로 이해할 수 있어.\n게다가..."
  },
  {
   "id": "TX7_7#6",
   "ko": "너랑 함께라면 뭐든 할 수 있을 것 같아."
  },
  {
   "id": "TX7_7#7",
   "ko": "그러고 보니 이사, 아까 옛날 일을 하나 떠올렸어."
  },
  {
   "id": "TX7_7#8",
   "ko": "헤에, 뭔데?   들려줘."
  },
  {
   "id": "TX7_7#9",
   "ko": "나는 아주 먼 옛날, 이렇게 불린 적이 있었어."
  },
  {
   "id": "TX7_7#10",
   "ko": "『아치』라고."
  }
 ]
}